# ─── ColocCI Backend – Variables d'environnement ───────────────────────────
# Copier ce fichier en .env et remplir les valeurs

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-super-secret-key-colocCI-2024

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=colocci_db
DB_USER=root
DB_PASSWORD=your_mysql_password

# JWT
JWT_SECRET_KEY=change-me-jwt-secret-key-colocCI-2024
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Mail (ex. Gmail)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=ColocCI <your_email@gmail.com>

# Upload
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=5
